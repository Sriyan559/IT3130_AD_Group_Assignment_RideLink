{
  "info": {
    "name": "RideLink - Four Service Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run all requests in order using start-local.ps1. Four authenticated services, automatic matching and completion payment, fare/receipt lookup and failed-payment retry. Uses separate local Mongo databases and persistent H2 SQL demo storage. Default Fare runtime supports PostgreSQL."
  },
  "variable": [
    {
      "key": "accountUrl",
      "value": "http://localhost:18081",
      "type": "string"
    },
    {
      "key": "driverUrl",
      "value": "http://localhost:18082",
      "type": "string"
    },
    {
      "key": "rideUrl",
      "value": "http://localhost:18083",
      "type": "string"
    },
    {
      "key": "paymentUrl",
      "value": "http://localhost:18084",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Register driver account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{accountUrl}}/api/auth/register/driver",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Integration Driver\",\n  \"email\": \"driver-{{runId}}@example.com\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"+94771234567\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.collectionVariables.set(\"runId\", id);",
              "pm.collectionVariables.set(\"testPassword\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.set(\"testPlate\", \"IT\" + id.replace(/-/g, \"\").slice(0, 16));",
              "// Give this run a distinct pickup so older AVAILABLE demo drivers do not tie at 0 km.",
              "pm.collectionVariables.set(\"demoLat\", (6.90 + parseInt(id.replace(/-/g, \"\").slice(0, 8), 16) / 0xffffffff * 0.05).toFixed(8));",
              "pm.collectionVariables.set(\"demoLng\", (79.84 + parseInt(id.replace(/-/g, \"\").slice(8, 16), 16) / 0xffffffff * 0.05).toFixed(8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"driverAccountId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login driver",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{accountUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"driver-{{runId}}@example.com\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
