        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ride COMPLETED\", () => pm.expect(pm.response.json().status).to.eql(\"COMPLETED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Check released AVAILABLE",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{driverUrl}}/api/drivers/{{driverId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
