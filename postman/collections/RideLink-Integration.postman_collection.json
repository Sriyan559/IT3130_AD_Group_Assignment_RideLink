    {
      "name": "09 Find eligible driver",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{driverUrl}}/api/drivers/eligible?lat={{demoLat}}&lng={{demoLng}}&radius=5",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Own driver is eligible\", () => pm.expect(pm.response.json().some(d => d.driverId === pm.collectionVariables.get(\"driverId\"))).to.eql(true));"
            ]
          }
        }
      ]
    },
