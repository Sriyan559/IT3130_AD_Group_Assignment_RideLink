{
  "info": {
    "name": "RideLink - Authenticated Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against start-local.ps1. Registers real accounts and captures tokens. Each run creates isolated demo identities; database is retained. Internal service token is never exposed."
  },
  "variable": [
    {
      "key": "accountUrl",
      "value": "http://localhost:18081",
      "type": "string"
    },
    {
      "key": "driverUrl",
      "value": "http://localhost:18082",
      "type": "string"
    },
    {
      "key": "rideUrl",
      "value": "http://localhost:18083",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Register driver account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{accountUrl}}/api/auth/register/driver",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Integration Driver\",\n  \"email\": \"driver-{{runId}}@example.com\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"+94771234567\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.collectionVariables.set(\"runId\", id);",
              "pm.collectionVariables.set(\"testPassword\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.set(\"testPlate\", \"IT\" + id.replace(/-/g, \"\").slice(0, 16));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"driverAccountId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login driver",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{accountUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"driver-{{runId}}@example.com\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"driverToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Register passenger account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{accountUrl}}/api/auth/register/passenger",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Integration Passenger\",\n  \"email\": \"passenger-{{runId}}@example.com\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"+94771234567\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"passengerId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Login passenger",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{accountUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"passenger-{{runId}}@example.com\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"passengerToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Create driver profile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{driverUrl}}/api/drivers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{driverAccountId}}\",\n  \"licenseNumber\": \"LIC-{{runId}}\",\n  \"serviceArea\": \"Colombo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"driverId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Register vehicle",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{driverUrl}}/api/drivers/{{driverId}}/vehicles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"plateNumber\": \"{{testPlate}}\",\n  \"make\": \"Toyota\",\n  \"model\": \"Aqua\",\n  \"vehicleClass\": \"CAR\",\n  \"capacity\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Set AVAILABLE",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{driverUrl}}/api/drivers/{{driverId}}/availability",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"availabilityStatus\": \"AVAILABLE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Update location",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{driverUrl}}/api/drivers/{{driverId}}/location",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 6.9271,\n  \"longitude\": 79.8612\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Find eligible driver",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{driverUrl}}/api/drivers/eligible?lat=6.9271&lng=79.8612&radius=5",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Own driver is eligible\", () => pm.expect(pm.response.json().some(d => d.driverId === pm.collectionVariables.get(\"driverId\"))).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Create ride",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{rideUrl}}/api/v1/rides",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passengerId\": \"{{passengerId}}\",\n  \"pickupLatitude\": 6.9271,\n  \"pickupLongitude\": 79.8612,\n  \"pickupAddress\": \"Colombo\",\n  \"destinationLatitude\": 6.92,\n  \"destinationLongitude\": 79.86,\n  \"destinationAddress\": \"Destination\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"rideId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Assign driver",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{rideUrl}}/api/v1/rides/{{rideId}}/assign-driver/{{driverId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Assigned\", () => pm.expect(pm.response.json().status).to.eql(\"ASSIGNED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Check ON_TRIP",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{driverUrl}}/api/drivers/{{driverId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{driverToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Reserved\", () => pm.expect(pm.response.json().availabilityStatus).to.eql(\"ON_TRIP\"));"
            ]
          }
        }
      ]
    },
