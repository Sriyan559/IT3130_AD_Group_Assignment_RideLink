              "pm.test(\"Released\", () => pm.expect(pm.response.json().availabilityStatus).to.eql(\"AVAILABLE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Wrong owner rejected",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{driverUrl}}/api/drivers/{{driverId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Missing token rejected",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{driverUrl}}/api/drivers/{{driverId}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "19 Set OFFLINE",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{driverUrl}}/api/drivers/{{driverId}}/availability",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"availabilityStatus\": \"OFFLINE\"\n}",
          "options": {
