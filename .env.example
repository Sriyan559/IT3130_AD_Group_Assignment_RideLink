# ==============================================================================
# RideLink - Environment Variable Template (.env.example)
# DO NOT COMMIT REAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL
# Copy this file to .env for local testing if needed
# ==============================================================================

# Global Spring Profile
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# 1. Account Service Configuration (Port 8081)
# ------------------------------------------------------------------------------
ACCOUNT_SERVICE_PORT=8081
MONGODB_URI=mongodb://localhost:27017/account_db
MONGODB_DATABASE=ridelink_account_db
JWT_SECRET=<secure-random-secret-at-least-32-bytes>
JWT_EXPIRATION_MS=3600000

# Enable only long enough to create the first ADMIN, then set back to false.
ACCOUNT_ADMIN_BOOTSTRAP_ENABLED=false
ACCOUNT_ADMIN_EMAIL=admin@example.com
ACCOUNT_ADMIN_PASSWORD=<strong-admin-password>
ACCOUNT_ADMIN_FULL_NAME=RideLink Administrator
ACCOUNT_ADMIN_PHONE=+94700000000

# Temporary protection for POST /api/auth/register/admin. Use a random key of at least 16 characters.
ACCOUNT_ADMIN_REGISTRATION_ENABLED=false
ACCOUNT_ADMIN_REGISTRATION_KEY=<random-admin-registration-key>

# ------------------------------------------------------------------------------
# 2. Driver & Vehicle Service Configuration (Port 8082)
# ------------------------------------------------------------------------------
DRIVER_SERVICE_PORT=8082
DRIVER_DB_HOST=localhost
DRIVER_DB_PORT=27017
DRIVER_DB_NAME=driver_db
DRIVER_DB_USERNAME=driver_user
DRIVER_DB_PASSWORD=driver_password_placeholder
DRIVER_DB_AUTH_DB=admin

# ------------------------------------------------------------------------------
# 3. Ride Management Service Configuration (Port 8083)
# ------------------------------------------------------------------------------
RIDE_SERVICE_PORT=8083
RIDE_DB_HOST=localhost
RIDE_DB_PORT=5432
RIDE_DB_NAME=ride_db
RIDE_DB_USERNAME=ride_user
RIDE_DB_PASSWORD=ride_password_placeholder

# Downstream Service URLs for Ride Management Service
ACCOUNT_SERVICE_URL=http://localhost:8081
DRIVER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8084

# ------------------------------------------------------------------------------
# 4. Fare & Payment Service Configuration (Port 8084)
# ------------------------------------------------------------------------------
PAYMENT_SERVICE_PORT=8084
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5432
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=payment_password_placeholder
