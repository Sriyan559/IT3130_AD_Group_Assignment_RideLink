# RideLink - Git Ignore Specification
# Spring Boot / Java / Maven

# Compiled class files
*.class

# Log files
*.log
logs/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build directory
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle (if any)
.gradle
/build/

# Virtual Machine crash logs
hs_err_pid*
replay_pid*

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
.classpath
.project
.settings/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Sensitive local configurations and environment files
.env
.env.local
.env.*.local
application-local.yml
application-local.properties
application-secrets.yml
secrets/

# Temporary / Scratch files
tmp/
temp/
scratch/
*.swp
*~
