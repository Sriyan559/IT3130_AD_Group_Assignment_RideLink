# Example Local Development Override Configuration for Account Service
# Copy to application-local.yml (which is ignored by Git) for local testing

server:
  port: 8081

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/account_db
    username: postgres
    password: local_dev_password
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

security:
  jwt:
    secret: your_local_testing_secret_key_minimum_256_bits_for_hmac_sha256
    expiration-ms: 86400000
